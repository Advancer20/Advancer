<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ADVANCER | Moda esportiva masculina</title>
<meta name="description" content="Roupas esportivas e de academia. Peça pelo WhatsApp.">
<meta name="theme-color" content="#000000">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--k:#000;--w:#fff;--y:#FFD400;--g:#f2f2f2;--m:#6b6b6b;
--d:"Barlow Condensed","Arial Narrow",Impact,sans-serif;--b:"Barlow",system-ui,-apple-system,Arial,sans-serif}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:64px}
body{font:400 16px/1.5 var(--b);color:var(--k);background:var(--w);-webkit-text-size-adjust:100%}
button,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--y);outline-offset:2px}
.wrap{max-width:1100px;margin:0 auto;padding:0 18px}
header{position:sticky;top:0;z-index:20;background:var(--k);color:var(--w)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:58px}
.logo{font:800 28px/1 var(--d);letter-spacing:.06em;color:var(--w);text-decoration:none}
.logo i{color:var(--y);font-style:normal}
nav{display:flex;gap:18px;align-items:center}
nav a{color:var(--w);text-decoration:none;font-weight:600;font-size:14px}
.cartbtn{background:var(--y);color:var(--k);border:0;border-radius:99px;padding:8px 14px;font-weight:600;display:flex;gap:8px;align-items:center}
.cartbtn b{background:var(--k);color:var(--y);border-radius:99px;min-width:22px;height:22px;display:grid;place-items:center;font-size:12px}
@media(max-width:560px){nav a{display:none}}
.hero{background:var(--k);color:var(--w);padding:56px 0 0;overflow:hidden}
.hero h1{font:800 clamp(64px,22vw,230px)/.82 var(--d);letter-spacing:.02em;margin-left:-.04em}
.hero p{max-width:30ch;font-size:20px;margin:22px 0 26px;color:#ddd}
.btn{display:inline-block;background:var(--y);color:var(--k);border:0;padding:14px 26px;font:800 20px/1 var(--d);letter-spacing:.06em;text-decoration:none;text-transform:uppercase}
.btn:active{transform:translateY(1px)}
.btn.dark{background:var(--k);color:var(--y)}
.strip{background:var(--y);color:var(--k);margin-top:48px;padding:12px 0;font:800 20px/1 var(--d);letter-spacing:.08em;white-space:nowrap;overflow:hidden}
.strip span{display:inline-block;padding-right:28px}
section{padding:56px 0}
h2{font:800 clamp(38px,9vw,64px)/.95 var(--d);margin-bottom:8px}
.sub{color:var(--m);margin-bottom:24px}
.chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px;margin-bottom:18px}
.chip{flex:none;border:2px solid var(--k);background:var(--w);padding:8px 16px;font-weight:600;border-radius:99px}
.chip[aria-pressed=true]{background:var(--k);color:var(--y)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media(min-width:760px){.grid{grid-template-columns:repeat(4,1fr);gap:20px}.grid.c3{grid-template-columns:repeat(3,1fr)}}
.card{display:flex;flex-direction:column;background:var(--w);border:2px solid var(--k)}
.ph{aspect-ratio:4/5;background:var(--k);color:var(--y);display:grid;place-items:center;font:800 72px/1 var(--d);position:relative;background-size:cover;background-position:center}
.ph small{position:absolute;left:8px;bottom:8px;background:var(--y);color:var(--k);font:600 12px/1 var(--b);padding:4px 7px}
.info{padding:12px;display:flex;flex-direction:column;gap:10px;flex:1}
.info h3{font:800 22px/1.05 var(--d)}
.price{font:800 24px/1 var(--d)}
.row{display:flex;gap:8px}
select{flex:1;min-width:0;border:2px solid var(--k);background:var(--w);padding:8px;border-radius:0}
.qty{display:flex;border:2px solid var(--k)}
.qty button{width:34px;border:0;background:var(--g);font-weight:800}
.qty span{min-width:30px;display:grid;place-items:center;font-weight:600}
.add{margin-top:auto;background:var(--k);color:var(--w);border:0;padding:12px;font:800 18px/1 var(--d);letter-spacing:.06em;text-transform:uppercase}
.add:hover{color:var(--y)}
#combos{background:var(--y)}
#combos .sub{color:#333}
#combos .card{border-color:var(--k)}
#combos .ph{background:var(--k)}
.tag{display:inline-block;background:var(--k);color:var(--y);font:600 13px/1 var(--b);padding:5px 8px;align-self:flex-start}
.how{display:grid;gap:14px;margin-top:8px}
@media(min-width:760px){.how{grid-template-columns:repeat(3,1fr)}}
.how div{border-top:4px solid var(--y);padding-top:10px}
.how h3{font:800 24px/1 var(--d);margin-bottom:4px}
footer{background:var(--k);color:#bbb;padding:36px 0 90px;text-align:center;font-size:14px}
footer .logo{display:block;margin-bottom:8px}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:30;display:none}
.ov.on{display:block}
.drawer{position:fixed;z-index:31;background:var(--w);display:none;flex-direction:column;right:0;top:0;bottom:0;width:min(420px,100%)}
.drawer.on{display:flex}
.dh{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:var(--k);color:var(--w)}
.dh h2{font-size:30px;margin:0}
.x{background:none;border:0;color:var(--y);font-size:32px;line-height:1}
.items{flex:1;overflow-y:auto;padding:6px 18px}
.it{display:grid;grid-template-columns:1fr auto;gap:4px 10px;padding:14px 0;border-bottom:1px solid #ddd}
.it b{font-weight:600}.it small{color:var(--m)}
.it .qty{grid-column:1;width:max-content}
.rm{background:none;border:0;color:var(--m);text-decoration:underline;grid-column:2;grid-row:2;justify-self:end;align-self:center}
.empty{padding:36px 0;text-align:center;color:var(--m)}
.df{padding:16px 18px;border-top:3px solid var(--k);display:grid;gap:12px}
.tot{display:flex;justify-content:space-between;font:800 30px/1 var(--d)}
.wa{background:#25D366;color:var(--k);text-align:center;text-decoration:none;font:800 20px/1 var(--d);letter-spacing:.05em;text-transform:uppercase;padding:16px}
.wa.off{pointer-events:none;opacity:.4}
.note{font-size:13px;color:var(--m);text-align:center}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%) translateY(80px);background:var(--k);color:var(--y);padding:12px 20px;font-weight:600;z-index:40;transition:transform .25s}
.toast.on{transform:translateX(-50%) translateY(0)}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.toast{transition:none}}
</style>
</head>
<body>
<header>
 <div class="wrap">
  <a class="logo" href="#topo">ADVANCER<i>.</i></a>
  <nav>
   <a href="#catalogo">Catálogo</a><a href="#combos">Combos</a>
   <button class="cartbtn" id="abrir" aria-label="Abrir carrinho">Carrinho <b id="cnt">0</b></button>
  </nav>
 </div>
</header>

<main id="topo">
<div class="hero">
 <div class="wrap">
  <h1>ADVANCER</h1>
  <p>Moda esportiva masculina para treinar, sem abrir mão do visual.</p>
  <a class="btn" href="#catalogo">Ver catálogo</a>
 </div>
 <div class="strip" aria-hidden="true"><span>ROUPA DE TREINO</span><span>COMPRESSÃO</span><span>CARGO</span><span>SHORTS</span><span>ROUPA DE TREINO</span><span>COMPRESSÃO</span><span>CARGO</span></div>
</div>

<section id="catalogo">
 <div class="wrap">
  <h2>Catálogo</h2>
  <p class="sub">Escolha o tamanho e a quantidade e adicione ao carrinho.</p>
  <div class="chips" id="chips"></div>
  <div class="grid" id="grid"></div>
 </div>
</section>

<section id="combos">
 <div class="wrap">
  <h2>Combos e promoções</h2>
  <p class="sub">Monte o look completo e compre junto.</p>
  <div class="grid c3" id="gridCombos"></div>
 </div>
</section>

<section>
 <div class="wrap">
  <h2>Como comprar</h2>
  <div class="how">
   <div><h3>Escolha</h3><p>Selecione tamanho e quantidade e adicione ao carrinho.</p></div>
   <div><h3>Envie</h3><p>Toque em “Finalizar no WhatsApp” e o pedido já vai pronto na conversa.</p></div>
   <div><h3>Combine</h3><p>Confirmamos estoque, entrega e pagamento direto com você.</p></div>
  </div>
 </div>
</section>
</main>

<footer>
 <a class="logo" href="#topo">ADVANCER<i>.</i></a>
 <p>Loja online de moda esportiva masculina.</p>
 <p><a id="insta" style="color:var(--y)" href="#">@advancer_ofc</a></p>
</footer>

<div class="ov" id="ov"></div>
<aside class="drawer" id="drawer" aria-label="Carrinho">
 <div class="dh"><h2>Seu carrinho</h2><button class="x" id="fechar" aria-label="Fechar">×</button></div>
 <div class="items" id="items"></div>
 <div class="df">
  <div class="tot"><span>Total</span><span id="total">R$ 0,00</span></div>
  <a class="wa off" id="wa" href="#" target="_blank" rel="noopener">Finalizar no WhatsApp</a>
  <p class="note">Frete e forma de pagamento combinados no WhatsApp.</p>
  <button class="add" id="limpar" style="background:var(--g);color:var(--k)">Limpar carrinho</button>
 </div>
</aside>
<div class="toast" id="toast" role="status"></div>

<script>
/* ================= CONFIGURAÇÃO (edite aqui) ================= */
const CONFIG = {
  whatsapp: "5595991327526",   // 55 + DDD 95 + número, só dígitos
  instagram: "advancer_ofc"
};
const CATEGORIAS = {
  camisetas: "Camisetas", compressao: "Compressão", shorts: "Shorts",
  cargo: "Calças cargo", acessorios: "Acessórios"
};
const ROUPA = ["P","M","G","GG"], CALCA = ["38","40","42","44"], UNICO = ["Único"];
/* PRODUTOS DE DEMONSTRAÇÃO: troque nome, preço, tamanhos e foto (img: "fotos/arquivo.jpg") */
const PRODUTOS = [
  {id:"c1",cat:"camisetas",nome:"Camiseta Dry-Fit Preta",preco:59.90,tam:ROUPA},
  {id:"c2",cat:"camisetas",nome:"Camiseta Oversized Branca",preco:69.90,tam:ROUPA},
  {id:"c3",cat:"camisetas",nome:"Regata de Treino",preco:49.90,tam:ROUPA},
  {id:"p1",cat:"compressao",nome:"Compressão Dry-Fit Preta",preco:79.90,tam:ROUPA},
  {id:"p2",cat:"compressao",nome:"Compressão Amarela",preco:79.90,tam:ROUPA},
  {id:"s1",cat:"shorts",nome:"Short de Treino Preto",preco:64.90,tam:ROUPA},
  {id:"s2",cat:"shorts",nome:"Short Tactel Cinza",preco:59.90,tam:ROUPA},
  {id:"g1",cat:"cargo",nome:"Calça Cargo Preta",preco:129.90,tam:CALCA},
  {id:"g2",cat:"cargo",nome:"Calça Cargo Cinza",preco:129.90,tam:CALCA},
  {id:"a1",cat:"acessorios",nome:"Boné ADVANCER",preco:39.90,tam:UNICO},
  {id:"a2",cat:"acessorios",nome:"Garrafa Térmica",preco:49.90,tam:UNICO},
  {id:"a3",cat:"acessorios",nome:"Luva de Treino",preco:34.90,tam:ROUPA}
];
/* COMBOS DE DEMONSTRAÇÃO: preços a definir por você */
const COMBOS = [
  {id:"k1",nome:"Conjunto Dry-Fit + Perfume",preco:159.90,tam:ROUPA,desc:"Conjunto de treino com perfume importado."},
  {id:"k2",nome:"Camiseta + Perfume",preco:99.90,tam:ROUPA,desc:"Camiseta de treino com perfume importado."},
  {id:"k3",nome:"Short + Perfume",preco:99.90,tam:ROUPA,desc:"Short de treino com perfume importado."}
];
/* ============================================================= */

const $ = s => document.querySelector(s);
const brl = n => n.toLocaleString("pt-BR",{style:"currency",currency:"BRL"});
const ALL = [...PRODUTOS, ...COMBOS];
let filtro = "todos", carrinho = [];
try { carrinho = JSON.parse(localStorage.getItem("advancer_cart")) || []; } catch(e) { carrinho = []; }
const salvar = () => { try { localStorage.setItem("advancer_cart", JSON.stringify(carrinho)); } catch(e) {} };

function card(p, combo){
  const bg = p.img ? ` style="background-image:url('${p.img}')"` : "";
  const letra = p.img ? "" : p.nome.charAt(0);
  const rotulo = combo ? "Combo" : CATEGORIAS[p.cat];
  return `<article class="card" data-id="${p.id}">
    <div class="ph"${bg}>${letra}<small>${rotulo}</small></div>
    <div class="info">
      <h3>${p.nome}</h3>
      ${combo ? `<p style="font-size:14px">${p.desc}</p>` : ""}
      <div class="price">${brl(p.preco)}</div>
      <div class="row">
        <select aria-label="Tamanho">${p.tam.map(t=>`<option>${t}</option>`).join("")}</select>
        <div class="qty"><button data-a="menos" aria-label="Diminuir">−</button><span class="q">1</span><button data-a="mais" aria-label="Aumentar">+</button></div>
      </div>
      <button class="add" data-a="add">Adicionar</button>
    </div></article>`;
}
function render(){
  $("#chips").innerHTML = [["todos","Todos"],...Object.entries(CATEGORIAS)]
    .map(([k,v])=>`<button class="chip" data-f="${k}" aria-pressed="${k===filtro}">${v}</button>`).join("");
  $("#grid").innerHTML = PRODUTOS.filter(p=>filtro==="todos"||p.cat===filtro).map(p=>card(p,false)).join("");
  $("#gridCombos").innerHTML = COMBOS.map(p=>card(p,true)).join("");
}
function renderCarrinho(){
  const el = $("#items");
  let total = 0, qtd = 0, linhas = [];
  el.innerHTML = carrinho.length ? carrinho.map((c,i)=>{
    const p = ALL.find(x=>x.id===c.id); if(!p) return "";
    total += p.preco*c.qtd; qtd += c.qtd;
    linhas.push(`• ${c.qtd}x ${p.nome} (tam. ${c.tam}) - ${brl(p.preco*c.qtd)}`);
    return `<div class="it"><div><b>${p.nome}</b><br><small>Tamanho ${c.tam} · ${brl(p.preco)} cada</small></div>
      <b>${brl(p.preco*c.qtd)}</b>
      <div class="qty"><button data-c="menos" data-i="${i}" aria-label="Diminuir">−</button><span>${c.qtd}</span><button data-c="mais" data-i="${i}" aria-label="Aumentar">+</button></div>
      <button class="rm" data-c="rm" data-i="${i}">Remover</button></div>`;
  }).join("") : `<p class="empty">Seu carrinho está vazio.<br>Adicione uma peça para começar.</p>`;
  $("#total").textContent = brl(total);
  $("#cnt").textContent = qtd;
  const wa = $("#wa");
  if(qtd){
    const msg = `Olá! Quero fazer um pedido na ADVANCER:\n\n${linhas.join("\n")}\n\nTotal: ${brl(total)}`;
    wa.href = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(msg)}`;
    wa.classList.remove("off");
  } else { wa.href = "#"; wa.classList.add("off"); }
  salvar();
}
function aviso(t){ const el=$("#toast"); el.textContent=t; el.classList.add("on"); clearTimeout(aviso.t); aviso.t=setTimeout(()=>el.classList.remove("on"),1800); }
function abrir(on){ $("#drawer").classList.toggle("on",on); $("#ov").classList.toggle("on",on); document.body.style.overflow = on ? "hidden" : ""; }

document.addEventListener("click", e=>{
  const t = e.target.closest("button"); if(!t) return;
  if(t.dataset.f){ filtro = t.dataset.f; render(); return; }
  const cardEl = t.closest(".card");
  if(cardEl && t.dataset.a){
    const q = cardEl.querySelector(".q"); let n = +q.textContent;
    if(t.dataset.a==="mais") q.textContent = Math.min(n+1,99);
    if(t.dataset.a==="menos") q.textContent = Math.max(n-1,1);
    if(t.dataset.a==="add"){
      const id = cardEl.dataset.id, tam = cardEl.querySelector("select").value, qtd = +q.textContent;
      const ex = carrinho.find(c=>c.id===id && c.tam===tam);
      ex ? ex.qtd = Math.min(ex.qtd+qtd,99) : carrinho.push({id,tam,qtd});
      q.textContent = 1; renderCarrinho(); aviso("Adicionado ao carrinho");
    }
    return;
  }
  if(t.dataset.c){
    const i = +t.dataset.i, c = carrinho[i];
    if(t.dataset.c==="mais") c.qtd = Math.min(c.qtd+1,99);
    if(t.dataset.c==="menos") c.qtd--;
    if(t.dataset.c==="rm" || c.qtd<1) carrinho.splice(i,1);
    renderCarrinho();
  }
});
$("#abrir").onclick = () => abrir(true);
$("#fechar").onclick = $("#ov").onclick = () => abrir(false);
$("#limpar").onclick = () => { carrinho = []; renderCarrinho(); };
document.addEventListener("keydown", e => { if(e.key==="Escape") abrir(false); });
$("#insta").href = "https://instagram.com/" + CONFIG.instagram;
render(); renderCarrinho();
</script>
</body>
</html>
